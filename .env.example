##########################################################################
# Plumber Platform v2 configuration file                                 #
# Documentation: https://getplumber.io/docs/installation/docker-compose/ #
##########################################################################
#
# Copy to .env (or let ./install.sh write it). PLATFORM_VERSION is NOT set
# here: it lives in versions.env and is synced into .env by install.sh and
# scripts/update.sh, so one variable pins both images (backend + frontend).

# Required configuration
DOMAIN_NAME=""
GITLAB_URL=""

# Auto-generated secrets (populated by install script)
# PLUMBER_TOKEN_ENCRYPTION_KEY must be exactly 64 hex chars (openssl rand -hex 32).
# It seals every GitLab OAuth secret and token at rest; back it up, it cannot
# be rotated in place.
PLUMBER_TOKEN_ENCRYPTION_KEY=""
PLUMBER_DB_PASSWORD=""
PLUMBER_REDIS_PASSWORD=""

# Deployment profile (set by install script)
# Options: letsencrypt or custom-certs, combined with internal-db or omit for external
COMPOSE_PROFILES="letsencrypt,internal-db"
CERT_RESOLVER="le"

# Optional: GitLab instances allowed to push analysis results (comma-separated
# base URLs). Defaults to GITLAB_URL.
# PLUMBER_OIDC_ALLOWED_ISSUERS="https://gitlab.example.com"

# Optional: Override database defaults (only needed when NOT using internal-db profile)
# PLUMBER_DB_HOST="your-db-host"
# PLUMBER_DB_PORT="5432"
# PLUMBER_DB_USER="plumber"
# PLUMBER_DB_NAME="plumber"
# PLUMBER_DB_SSLMODE="disable"          # disable|allow|prefer|require|verify-ca|verify-full
# PLUMBER_DB_SSLROOTCERT=""             # PEM path inside the container (mount it yourself)
# PLUMBER_DB_TIMEZONE="UTC"

# Optional: private CA for your GitLab instance. Drop .pem/.crt files into
# .docker/ca-certificates/ and run scripts/ca-bundle.sh (install.sh and
# scripts/update.sh do it for you); it sets this line when needed.
# PLUMBER_PROVIDER_CA_BUNDLE="/usr/local/share/ca-certificates/plumber-ca.bundle"

# Optional: air-gapped install, disable the daily update check entirely
# PLUMBER_UPDATE_CHECK_URL="off"

# Optional tuning
# PLUMBER_LOG_LEVEL="info"              # debug|info|warn|error
# PLUMBER_LOG_FORMAT="json"             # json|text
# PLUMBER_SESSION_TTL="168h"
# PLUMBER_RETENTION_DAYS="30"           # floor 2
# PLUMBER_TRUSTED_PROXY_CIDRS=""        # only if a proxy hop is outside private ranges
